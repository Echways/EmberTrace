{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EmberTrace": {
    "Enabled": true,
    "ChunkCapacity": 16384,
    "OverflowPolicy": "DropOldest",
    "MaxRetentionWindow": "00:00:30",
    "MaxTotalChunks": 256,
    "RuntimeCounters": "Gc, Memory",
    "Requests": {
      "Enabled": true,
      "Category": "Http",
      "IgnoredPaths": [ "/health", "/embertrace" ]
    },
    "Dump": {
      "Enabled": true,
      "Path": "/embertrace/dump",
      "RestrictToLoopback": true,
      "Window": "00:00:10"
    },
    "SlowRequests": {
      "Enabled": true,
      "Threshold": "00:00:00.030",
      "Window": "00:00:10",
      "Cooldown": "00:00:30",
      "Directory": "slow-requests"
    }
  }
}
