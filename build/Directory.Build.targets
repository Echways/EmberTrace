<Project>
    <PropertyGroup Condition="'$(IsRoslynComponent)' == 'true'">
        <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
        <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <Target Name="EmberTrace_ValidateDirectoryBuildFiles" BeforeTargets="PrepareForBuild"/>

    <PropertyGroup>
        <AuthoredApiDocs>$(MSBuildProjectDirectory)/$(AssemblyName).xml</AuthoredApiDocs>
    </PropertyGroup>

    <Target Name="EmberTrace_UseAuthoredApiDocs"
            AfterTargets="CoreCompile"
            Condition="Exists('$(AuthoredApiDocs)') And '@(DocFileItem)' != ''">
        <Copy SourceFiles="$(AuthoredApiDocs)" DestinationFiles="@(DocFileItem)" SkipUnchangedFiles="false"/>
    </Target>
</Project>
