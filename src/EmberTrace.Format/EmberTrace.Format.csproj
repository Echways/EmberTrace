<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <AssemblyName>EmberTrace.Format</AssemblyName>
        <RootNamespace>EmberTrace.Format</RootNamespace>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <PackageId>EmberTrace.Format</PackageId>
        <Title>EmberTrace.Format</Title>
        <Description>Compact binary persistence for EmberTrace sessions (.ember files).</Description>
        <Authors>Echways</Authors>
        <PackageTags>tracing;profiling;serialization;dotnet</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="EmberTrace.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EmberTrace\EmberTrace.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
